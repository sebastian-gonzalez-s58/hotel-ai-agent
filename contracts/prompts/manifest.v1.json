  "anchors": [
    {
      "document_glob": "effective/builders/V2_AGENT_TURN/*",
      "id": "PA-001",
      "prompt_id": "PR-001",
      "rule_id": "BC-008",
      "text": "Propose only tools listed in toolPolicy.allowedTools."
    },
    {
      "document_glob": "effective/builders/V2_AGENT_TURN/*",
      "id": "PA-002",
      "prompt_id": "PR-001",
      "rule_id": "BC-001",
      "text": "Preserve its offering and every captured field."
    },
    {
      "document_glob": "effective/builders/V2_AGENT_TURN/*",
      "id": "PA-003",
      "prompt_id": "PR-001",
      "rule_id": "BC-006",
      "text": "Only a pure, unambiguous approval is confirmation."
    },
    {
      "document_glob": "effective/conversations/*/V2_HOTEL_SCOPE/*.prompt.txt",
      "id": "PA-004",
      "prompt_id": "PR-002",
      "rule_id": "BC-003",
      "text": "hasRequestDetails=true and replyAction=NONE, so the order extractor can apply that removal."
    },
    {
      "document_glob": "effective/conversations/*/V2_HOTEL_SCOPE/*.prompt.txt",
      "id": "PA-005",
      "prompt_id": "PR-002",
      "rule_id": "BC-013",
      "text": "Do not require the guest to repeat the order."
    },
    {
      "document_glob": "effective/conversations/*/V2_HOTEL_SCOPE/*.prompt.txt",
      "id": "PA-006",
      "prompt_id": "PR-002",
      "rule_id": "BC-005",
      "text": "requestedLanguage is non-null ONLY when the guest explicitly asks to speak that language."
    },
    {
      "document_glob": "effective/conversations/*/V2_ORDER_UNDERSTANDING/*.prompt.txt",
      "id": "PA-007",
      "prompt_id": "PR-012",
      "rule_id": "BC-001",
      "text": "Never default an absent, uncertain, fractional or conflicting quantity to 1."
    },
    {
      "document_glob": "effective/conversations/*/V2_SPA_EXTRACTION/*.prompt.txt",
      "id": "PA-008",
      "prompt_id": "PR-004",
      "rule_id": "BC-003",
      "text": "For a reply containing only a time, all other fields are UNCHANGED; preserve existing treatment/date."
    },
    {
      "document_glob": "effective/conversations/*/V2_SPA_EXTRACTION/*.prompt.txt",
      "id": "PA-009",
      "prompt_id": "PR-004",
      "rule_id": "BC-013",
      "text": "Keep the original treatment wording, without translating it or adding scheduling words."
    },
    {
      "document_glob": "effective/boundary/V2_FAQ_SEMANTIC_RETRIEVAL/*.prompt.txt",
      "id": "PA-010",
      "prompt_id": "PR-006",
      "rule_id": "BC-011",
      "text": "Never select the closest unrelated FAQ just because it is the only one."
    },
    {
      "document_glob": "effective/boundary/V2_FAQ_GROUNDING_CHECK/*.prompt.txt",
      "id": "PA-011",
      "prompt_id": "PR-007",
      "rule_id": "BC-011",
      "text": "preservesNegations: no dropped restrictions, exceptions, qualifiers, negations, or invented certainty."
    },
    {
      "document_glob": "effective/boundary/V2_LOCALIZATION/*.prompt.txt",
      "id": "PA-012",
      "prompt_id": "PR-008",
      "rule_id": "BC-013",
      "text": "negations, quantities, product names and ALL [[P...]] placeholders exactly once."
    },
    {
      "document_glob": "effective/builders/capabilities/*",
      "id": "PA-013",
      "prompt_id": "PR-009",
      "rule_id": "BC-012",
      "text": "Treat offering definitions and tool resources as authoritative"
    },
    {
      "document_glob": "effective/boundary/V2_AGENT_TURN_REPAIR/002.prompt.txt",
      "id": "PA-014",
      "prompt_id": "PR-001",
      "rule_id": "BC-014",
      "text": "exactly one COMPLETE_CONVERSATION_TASK"
    }
